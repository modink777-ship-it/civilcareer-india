{
  "functions": {
    "api/[[...path]].js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer.html"
    },
    {
      "source": "/role/:role",
      "destination": "/api/govt-public?role=:role"
    },
    {
      "source": "/department/:dept",
      "destination": "/api/govt-public?department=:dept"
    },
    {
      "source": "/state/:state",
      "destination": "/api/govt-public?state=:state"
    },
    {
      "source": "/government-jobs/:slug",
      "destination": "/api/govt-public?job=:slug"
    },
    {
      "source": "/government-jobs/central",
      "destination": "/api/govt-public?scope=central"
    },
    {
      "source": "/api/social-graphics",
      "destination": "/api/social-graphics-v4"
    },
    {
      "source": "/api/social-cron",
      "destination": "/api/social-graphics?delegate=social-cron"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/exams/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/job-alerts",
      "destination": "/job-alerts.html"
    },
    {
      "source": "/exam-tracker",
      "destination": "/exam-tracker.html"
    },
    {
      "source": "/salary",
      "destination": "/salary.html"
    },
    {
      "source": "/walk-in",
      "destination": "/walkin.html"
    },
    {
      "source": "/walk-in-interviews",
      "destination": "/walkin.html"
    },
    {
      "source": "/salary/:slug",
      "destination": "/salary.html"
    },
    {
      "source": "/career-guides",
      "destination": "/career-guides.html"
    },
    {
      "source": "/career-tools",
      "destination": "/career-tools.html"
    },
    {
      "source": "/exam-guides",
      "destination": "/exam-guides.html"
    },
    {
      "source": "/jobs/:slug",
      "destination": "/api/jobs?slug=:slug&render=html"
    },
    {
      "source": "/for-you",
      "destination": "/for-you.html"
    },
    {
      "source": "/private-jobs",
      "destination": "/private-jobs.html"
    },
    {
      "source": "/government-jobs",
      "destination": "/government-jobs.html"
    },
    {
      "source": "/exams",
      "destination": "/exams.html"
    },
    {
      "source": "/study-materials",
      "destination": "/study-materials.html"
    },
    {
      "source": "/post-a-job",
      "destination": "/index.html"
    },
    {
      "source": "/submit-resource",
      "destination": "/index.html"
    },
    {
      "source": "/report",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/career-paths",
      "destination": "/career-paths.html"
    },
    {
      "source": "/career-hub",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/api/admin-page"
    },
    {
      "source": "/admin.html",
      "destination": "/api/admin-page"
    },
    {
      "source": "/jobs/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/exams/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/study-materials/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/legal",
      "destination": "/legal.html"
    },
    {
      "source": "/create-profile",
      "destination": "/create-profile.html"
    },
    {
      "source": "/edit-profile",
      "destination": "/edit-profile.html"
    },
    {
      "source": "/talent",
      "destination": "/talent.html"
    },
    {
      "source": "/companies",
      "destination": "/companies.html"
    },
    {
      "source": "/companies/:slug",
      "destination": "/companies.html"
    },
    {
      "source": "/profile/:slug",
      "destination": "/profile.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog.html"
    },
    {
      "source": "/interview",
      "destination": "/interview.html"
    },
    {
      "source": "/interview/:slug",
      "destination": "/interview.html"
    },
    {
      "source": "/:seoSlug",
      "destination": "/api/seo-page?slug=:seoSlug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "0"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https:; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://api.groq.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/jobs?discovery=cron",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/exam-alerts",
      "schedule": "30 0 * * 1"
    },
    {
      "path": "/api/govt-expiry",
      "schedule": "20 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/legal.html",
      "destination": "/legal",
      "permanent": true
    },
    {
      "source": "/career-guides.html",
      "destination": "/career-guides",
      "permanent": true
    },
    {
      "source": "/career-tools.html",
      "destination": "/career-tools",
      "permanent": true
    },
    {
      "source": "/job-alerts.html",
      "destination": "/job-alerts",
      "permanent": true
    }
  ]
}
