[TEMPLATE]
# Required production variables
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OWNER_KEY=
AGENT_REACH_INGEST_KEY=
SITE_URL=https://civilcareer.example

# Vercel Cron bearer token. Sent as `Authorization: Bearer <CRON_SECRET>`
# by scheduled jobs; only the routes in the dispatcher's CRON_ROUTES
# (exam-alerts, govt-discovery) accept it — it never unlocks admin routes.
CRON_SECRET=

# Optional discovery/search/AI integrations
GROQ_API_KEY=
SERPAPI_KEY=
SERP_API_KEY=
MUSE_API_KEY=
THEMUSE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ── Social Content Engine (v27) ─────────────────
# Keeps the pre-v27 direct Telegram auto-post from the jobs
# publish hook ON while the engine does not yet cover jobs.
# 'true'/'1' = ON (default), anything else = OFF.
LEGACY_TELEGRAM_AUTOPOST=true
# Optional private channel id — the admin "Send test" button
# posts here first. Real sends always go to TELEGRAM_CHANNEL_ID.
TELEGRAM_TEST_CHANNEL_ID=

# Server-side admin allowlist for /api/social and the protected
# admin (checked on every request; being logged in is not enough).
ADMIN_EMAIL=
ADMIN_USER_ID=

# Phase 2 (Social Content Engine — LinkedIn + Instagram).
# Tokens live here in Vercel, never in the database.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
# Marketing API version the LinkedIn publisher pins (P5).
LINKEDIN_API_VERSION=202405
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Bearer token for scheduled Social engine jobs (e.g. the queue drain).
# Deliberately separate from CRON_SECRET: scheduler access to the social
# routes must not imply access to the discovery/govt crawler routes.
SOCIAL_CRON_SECRET=

# Cloudflare Turnstile — bot protection on public forms. When the secret is
# unset the server-side check is skipped (lib/rate-limit.js) so forms keep
# working in development.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional aliases used by legacy integrations
SUPABASE_SERVICE_KEY=
CIVILCAREER_OWNER_KEY=
ADMIN_OWNER_KEY=
