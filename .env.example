[TEMPLATE]
# Required production variables
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OWNER_KEY=
AGENT_REACH_INGEST_KEY=
SITE_URL=https://civilcareer.example

# Vercel Cron bearer token. Sent as `Authorization: Bearer <CRON_SECRET>`
# by scheduled jobs; only the routes in the dispatcher's CRON_ROUTES
# (exam-alerts, govt-discovery) accept it — it never unlocks admin routes.
CRON_SECRET=

# Optional discovery/search/AI integrations
GROQ_API_KEY=
SERPAPI_KEY=
SERP_API_KEY=
MUSE_API_KEY=
THEMUSE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# ── Social Content Engine (v27) ─────────────────
# Phase 3: published job announcements flow through the
# engine queue as source_type 'job' suggestions instead of
# the pre-v27 direct Telegram auto-post.
# 'true'/'1' restores the legacy direct post; default OFF.
LEGACY_TELEGRAM_AUTOPOST=true
# Optional private channel id — the admin "Send test" button
# posts here first. Real sends always go to TELEGRAM_CHANNEL_ID.
TELEGRAM_TEST_CHANNEL_ID=

# Server-side admin allowlist for /api/social and the protected
# admin (checked on every request; being logged in is not enough).
ADMIN_EMAIL=
ADMIN_USER_ID=

# Later Social Engine platform integrations. Tokens live in Vercel,
# never in the database. Phase 4 targets a personal LinkedIn profile.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_API_VERSION=
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=

# Bearer token for the scheduled Social engine queue drain (Phase 2).
# GitHub Actions will call /api/social?op=drain on a 30–60 minute schedule.
# Accepted as Authorization: Bearer or the x-cron-secret header;
# unlocks ONLY op=drain — never the queue, settings or ledger.
# Deliberately separate from CRON_SECRET: scheduler access to the social
# drain must not imply access to the discovery/govt crawler routes.
SOCIAL_CRON_SECRET=

# Cloudflare Turnstile — bot protection on public forms. When the secret is
# unset the server-side check is skipped (lib/rate-limit.js) so forms keep
# working in development.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional aliases used by legacy integrations
SUPABASE_SERVICE_KEY=
CIVILCAREER_OWNER_KEY=
ADMIN_OWNER_KEY=
